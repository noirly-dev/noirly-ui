{
  "name": "noirly-ui-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noirly-dev/noirly-ui.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @noirly-dev/ui storybook",
    "build-storybook": "pnpm --filter @noirly-dev/ui build-storybook",
    "themes:verify": "node scripts/verify-contrast.mjs",
    "build:native": "pnpm --filter @noirly-dev/ui-native build",
    "storybook:native": "pnpm --filter @noirly-dev/ui-native storybook",
    "build-storybook:native": "pnpm --filter @noirly-dev/ui-native build-storybook"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0"
}
