{
  "name": "@noirly-dev/ui",
  "version": "0.3.1",
  "description": "Shared Noirly design system — tokens, themes, and UI components",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js",
      "default": "./dist/motion.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "import": "./dist/cursor.js",
      "default": "./dist/cursor.js"
    },
    "./scroll": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.js",
      "default": "./dist/scroll.js"
    },
    "./experience": {
      "types": "./dist/experience.d.ts",
      "import": "./dist/experience.js",
      "default": "./dist/experience.js"
    },
    "./styles.css": "./src/styles.css",
    "./effects.css": "./src/effects.css",
    "./transitions.css": "./src/transitions.css",
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.js",
      "default": "./dist/fonts/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "default": "./dist/themes/index.js"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/effects.css",
    "src/transitions.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ../../storybook-static"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noirly-dev/noirly-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "next": ">=16",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4",
    "framer-motion": ">=12",
    "lenis": ">=1.3"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "framer-motion": "^13.2.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.544.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "8.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.3"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "lenis": {
      "optional": true
    }
  }
}
